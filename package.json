{
  "name": "volt",
  "version": "1.0.0",
  "description": "Volt — turn geometry and algebra worksheets into study flashcards",
  "main": "main.js",
  "author": "Volt",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "icon": "node build/make-icon.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:all": "electron-builder -mwl"
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8",
    "rcedit": "^5.0.2"
  },
  "dependencies": {
    "katex": "^0.16.11",
    "pdfjs-dist": "^4.7.76",
    "tesseract.js": "^5.1.1"
  },
  "build": {
    "appId": "com.volt.flashcards",
    "productName": "Volt",
    "copyright": "Copyright © 2026 Volt",
    "afterPack": "build/afterPack.js",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/tesseract.js/**/*",
      "**/node_modules/tesseract.js-core/**/*",
      "**/node_modules/pdfjs-dist/**/*",
      "assets/**/*"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Volt",
      "artifactName": "Volt-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Volt-${version}-portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.education",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "artifactName": "Volt-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "icon": "build/icon.png"
    }
  },
  "private": true
}
